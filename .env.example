# Optional configuration overrides.
#
# You do NOT need this file to run the project:
#   - With Docker, these values are supplied by docker-compose.yml automatically.
#   - Without Docker, the app falls back to the local defaults shown below
#     (which match a stock Laragon / XAMPP install).
#
# Only copy this to ".env" and edit it if your local MySQL differs.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sweetwater_test
DB_USER=root
DB_PASS=
